<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dịch vụ SOAP kế thừa (được CUNG CẤP SẴN — sinh viên không cần sửa).
  POM độc lập (không kế thừa bookstore-parent) để có thể build riêng trong Dockerfile.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>vn.edu.bookstore</groupId>
  <artifactId>legacy-bookcatalog-soap</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>legacy-bookcatalog-soap (BookCatalogService, SOAP 1.1)</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jaxws.version>4.0.5</jaxws.version>
    <junit.version>5.13.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.sun.xml.ws</groupId>
      <artifactId>jaxws-rt</artifactId>
      <version>${jaxws.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
      <!-- Top-down: sinh SEI + lớp JAXB từ WSDL, rồi hiện thực SEI -->
      <plugin>
        <groupId>com.sun.xml.ws</groupId>
        <artifactId>jaxws-maven-plugin</artifactId>
        <version>${jaxws.version}</version>
        <executions>
          <execution>
            <id>wsimport-server</id>
            <goals><goal>wsimport</goal></goals>
            <configuration>
              <wsdlDirectory>${project.basedir}/src/main/resources/wsdl</wsdlDirectory>
              <wsdlFiles><wsdlFile>BookCatalogService.wsdl</wsdlFile></wsdlFiles>
              <wsdlLocation>wsdl/BookCatalogService.wsdl</wsdlLocation>
              <packageName>vn.edu.bookstore.legacy.soap.generated</packageName>
              <xnocompile>true</xnocompile>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Đóng gói jar chạy được (classifier all) cho Docker -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>vn.edu.bookstore.legacy.soap.LegacySoapServer</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
