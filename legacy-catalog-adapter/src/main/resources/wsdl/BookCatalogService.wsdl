<?xml version="1.0" encoding="UTF-8"?>
<!--
  BookCatalogService — dịch vụ SOAP kế thừa của bộ phận kho (SOAP 1.1, document/literal).
  Địa chỉ: http://localhost:8091/ws/catalog
-->
<wsdl:definitions name="BookCatalogService"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:bs="http://bookstore.edu.vn/catalog/v1"
    xmlns:msg="http://bookstore.edu.vn/catalog/messages/v1"
    xmlns:tns="http://bookstore.edu.vn/catalog/service/v1"
    targetNamespace="http://bookstore.edu.vn/catalog/service/v1">

  <!-- 1. types: kiểu dữ liệu và phần tử thông điệp -->
  <wsdl:types>
    <xs:schema targetNamespace="http://bookstore.edu.vn/catalog/messages/v1"
               elementFormDefault="qualified">
      <xs:import namespace="http://bookstore.edu.vn/catalog/v1"
                 schemaLocation="bookstore-catalog-v1.xsd"/>
      <xs:element name="GetBookRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="isbn" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="GetBookResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="book" type="bs:Book"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="SearchBooksRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="keyword" type="xs:string"/>
            <xs:element name="maxResults" type="xs:int" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="SearchBooksResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="book" type="bs:Book" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </wsdl:types>

  <!-- 2. message -->
  <wsdl:message name="GetBookRequest">
    <wsdl:part name="parameters" element="msg:GetBookRequest"/>
  </wsdl:message>
  <wsdl:message name="GetBookResponse">
    <wsdl:part name="parameters" element="msg:GetBookResponse"/>
  </wsdl:message>
  <wsdl:message name="SearchBooksRequest">
    <wsdl:part name="parameters" element="msg:SearchBooksRequest"/>
  </wsdl:message>
  <wsdl:message name="SearchBooksResponse">
    <wsdl:part name="parameters" element="msg:SearchBooksResponse"/>
  </wsdl:message>
  <wsdl:message name="BookCatalogFault">
    <wsdl:part name="fault" element="bs:ErrorDetail"/>
  </wsdl:message>

  <!-- 3. portType (phần trừu tượng) -->
  <wsdl:portType name="BookCatalogPortType">
    <wsdl:operation name="GetBook">
      <wsdl:input message="tns:GetBookRequest"/>
      <wsdl:output message="tns:GetBookResponse"/>
      <wsdl:fault name="BookCatalogFault" message="tns:BookCatalogFault"/>
    </wsdl:operation>
    <wsdl:operation name="SearchBooks">
      <wsdl:input message="tns:SearchBooksRequest"/>
      <wsdl:output message="tns:SearchBooksResponse"/>
      <wsdl:fault name="BookCatalogFault" message="tns:BookCatalogFault"/>
    </wsdl:operation>
  </wsdl:portType>

  <!-- 4. binding (phần cụ thể): SOAP 1.1 qua HTTP, document/literal -->
  <wsdl:binding name="BookCatalogSoapBinding" type="tns:BookCatalogPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="GetBook">
      <soap:operation soapAction="http://bookstore.edu.vn/catalog/GetBook"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="BookCatalogFault"><soap:fault name="BookCatalogFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="SearchBooks">
      <soap:operation soapAction="http://bookstore.edu.vn/catalog/SearchBooks"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="BookCatalogFault"><soap:fault name="BookCatalogFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
  </wsdl:binding>

  <!-- 5. service + port -->
  <wsdl:service name="BookCatalogService">
    <wsdl:port name="BookCatalogPort" binding="tns:BookCatalogSoapBinding">
      <soap:address location="http://localhost:8091/ws/catalog"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
